    {
      "name": "Payday Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Borderless white card with resting shadow; headline D-day and tabular figure.",
      "html": "<section class=\"ds-card\"><h2>다음 월급날</h2><p class=\"ds-dday\">D-13<small>11월 15일 (일)</small></p><p class=\"ds-amt\">1,135,200원</p><p class=\"ds-sub\">10월 근무분 · 110시간</p></section>",
      "css": ".ds-card{background:var(--card,#fff);border-radius:20px;box-shadow:var(--shadow,0 1px 2px rgba(60,45,30,.06),0 6px 20px rgba(60,45,30,.06));padding:22px;color:var(--ink,#222019);font:500 16px/1.55 'Gothic A1',system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-card h2{margin:0;font-size:1.0625rem;font-weight:700;letter-spacing:-.01em}.ds-dday{margin:10px 0 0;font-size:2.25rem;font-weight:800;letter-spacing:-.03em;line-height:1.1}.ds-dday small{font-size:1rem;font-weight:600;color:var(--muted,#625B53);margin-left:8px;letter-spacing:0}.ds-amt{margin:10px 0 0;font-size:1.375rem;font-weight:700}.ds-sub{margin:2px 0 0;font-size:.875rem;color:var(--muted,#625B53)}"
    },
    {
      "name": "Goal Ring",
      "kind": "custom",
      "refersTo": "goal-ring",
      "description": "Signature: single green arc filling over a sunk track, percentage centred.",
      "html": "<div class=\"ds-ring\"><svg viewBox=\"0 0 124 124\"><circle class=\"trk\" cx=\"62\" cy=\"62\" r=\"52\"/><circle class=\"arc\" cx=\"62\" cy=\"62\" r=\"52\" stroke-dasharray=\"326.73\" stroke-dashoffset=\"114\"/></svg><div class=\"pct\">65%<small>모였어요</small></div></div>",
      "css": ".ds-ring{position:relative;width:124px;height:124px;font-family:'Gothic A1',system-ui,sans-serif;color:var(--ink,#222019)}.ds-ring svg{width:100%;height:100%;transform:rotate(-90deg)}.ds-ring circle{fill:none;stroke-width:10}.ds-ring .trk{stroke:var(--sunk,#EFEAE3)}.ds-ring .arc{stroke:var(--act,#1F7A5A);stroke-linecap:round;transition:stroke-dashoffset 1s cubic-bezier(.16,1,.3,1)}.ds-ring .pct{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font-size:1.5rem;font-weight:800;letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}.ds-ring .pct small{display:block;font-size:.75rem;font-weight:600;color:var(--muted,#625B53);letter-spacing:0}"
    },
    {
      "name": "Live Amount",
      "kind": "custom",
      "refersTo": "display",
      "description": "The one loud number: heavy tabular amount with muted decimals and a rate line.",
      "html": "<div class=\"ds-live\"><p class=\"lbl\">오늘 번 돈</p><p class=\"amount\">14,685<span class=\"dec\">.94</span><span class=\"unit\">원</span></p><p class=\"rate\">시급 <b>10,320원</b> · 1초에 <b>2.87원</b></p></div>",
      "css": ".ds-live{font-family:'Gothic A1',system-ui,sans-serif;color:var(--ink,#222019);font-variant-numeric:tabular-nums}.ds-live p{margin:0}.ds-live .lbl{color:var(--muted,#625B53);font-weight:600}.ds-live .amount{font-size:clamp(2.75rem,10vw,4.25rem);font-weight:800;line-height:1.08;letter-spacing:-.035em;margin-top:2px}.ds-live .dec{font-size:.42em;font-weight:700;color:var(--muted,#625B53);letter-spacing:0}.ds-live .unit{font-size:.45em;font-weight:700;margin-left:.08em;letter-spacing:0}.ds-live .rate{margin-top:8px;color:var(--muted,#625B53);font-size:.9375rem}.ds-live .rate b{color:var(--ink,#222019);font-weight:700}"
    }
