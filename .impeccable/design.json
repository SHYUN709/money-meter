      "html": "<div class=\"ds-chips\"><button aria-pressed=\"true\">월</button><button aria-pressed=\"false\">화</button><button aria-pressed=\"true\">수</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px}.ds-chips button{min-width:48px;min-height:44px;padding:0 12px;border-radius:12px;border:1.5px solid var(--line,#E3DCD2);background:var(--card,#fff);color:var(--ink,#222019);font:700 16px 'Gothic A1',system-ui,sans-serif;cursor:pointer}.ds-chips button[aria-pressed=true]{border-color:var(--act,#1F7A5A);background:var(--act-soft,#E3F1EA);color:var(--act,#1F7A5A)}.ds-chips button:focus-visible{outline:2px solid var(--act,#1F7A5A);outline-offset:3px}"
