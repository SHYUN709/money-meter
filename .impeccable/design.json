  "narrative": {
    "northStar": "The Quiet Pay Slip",
    "overview": "A warm, paper-tinted everyday-money app. One column of soft white cards sits on an oat-coloured ground; the only loud thing on any screen is the money figure in heavy Gothic A1, and the only colour is a deep green that marks what you can press and what is live or filling up. Everything else is warm ink and warm grey.\n\nDensity is relaxed but not sparse: 16px gaps between cards, 22px inside them, hairline dividers instead of boxes within a card. Depth is a soft ambient lift, never an outline or an offset block. Motion is short and soft: a slight press-in on buttons, eased fills on bars and the goal ring, no entrance bounce.\n\nThe system ships in light and dark from the same token names; dark keeps the warmth (brown-black ground, not neutral grey) and lifts the green to a mint that keeps AA on dark cards.",
    "keyCharacteristics": [
      "Warm tinted ground, borderless white cards at 20px radius with ambient shadow.",
      "One action colour (green) reserved for pressables, live status, and progress/selected marks.",
      "One typeface, Gothic A1, carried from 0.75rem tags to a 4.25rem live amount; tabular figures on every money value.",
      "Line icons drawn as inline SVG symbols, 1.8 stroke, round caps.",
      "Floating bottom tab bar on every breakpoint."
    ],
    "rules": [
      { "name": "The Green Means Go Rule", "body": "Green appears only on something you can press, something live, or something filling/selected (bars, ring, checked state). It is never used to decorate a heading, a number or an icon at rest.", "section": "colors" },
      { "name": "The Same Names, Two Lights Rule", "body": "Every colour exists as one token name with a light and a dark value (`:root`, `prefers-color-scheme: dark`, and `[data-theme]` override). New surfaces use the variables, never literal hex.", "section": "colors" },
      { "name": "The Tabular Money Rule", "body": "Every money or count figure carries tabular numerals (`.num`), so ticking values never jitter.", "section": "typography" },
      { "name": "The One Loud Number Rule", "body": "Only one Display-size figure per screen: the live amount, or the next-shift time when resting. Other figures step down to Headline or below.", "section": "typography" },
      { "name": "The Lift, Not Line Rule", "body": "Cards have no border; separation comes from the tinted ground and the resting shadow. Inside a card, depth goes down (sunk-oat recesses), never up.", "section": "elevation" }
    ],
    "dos": [
      "**Do** put every new surface in a white 20px card on the oat ground with the Resting shadow.",
      "**Do** keep green for pressables, live status, and progress/selected state only.",
      "**Do** mark every money value with tabular numerals and keep a single Display-size figure per screen.",
      "**Do** draw icons as inline SVG line symbols (24 viewBox, 1.8 stroke, round caps, currentColor).",
      "**Do** keep controls at 44px minimum (48px for primary buttons and inputs) and respect `prefers-reduced-motion`, which disables all transitions.",
      "**Do** define any new colour in both light and dark token sets."
    ],
    "donts": [
      "**Don't** add borders or hard offset shadows to cards; use the three shadow tokens.",
      "**Don't** use gradients, emoji icons, or green on decorative text and numbers at rest.",
      "**Don't** introduce a second typeface or a display face for numbers; hierarchy comes from Gothic A1 weight and size.",
      "**Don't** add entrance bounces; motion is press feedback and eased fills only."
    ]
  }
}
