      "css": ".ds-seg{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:4px;border-radius:14px;background:var(--sunk,#EFEAE3);font-family:'Gothic A1',system-ui,sans-serif}.ds-seg button{min-height:40px;border:0;border-radius:10px;background:none;color:var(--muted,#625B53);font:600 .9375rem 'Gothic A1',system-ui,sans-serif;cursor:pointer}.ds-seg button:hover{color:var(--ink,#222019)}.ds-seg button[aria-pressed=true]{background:var(--card,#fff);color:var(--ink,#222019);box-shadow:var(--shadow-seg,0 1px 3px rgba(60,45,30,.12))}.ds-seg button:focus-visible{outline:2px solid var(--act,#1F7A5A);outline-offset:3px}"
