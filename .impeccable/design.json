      "css": ".ds-btn-danger{display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 20px;border-radius:14px;border:0;background:var(--danger-soft,#FBE9E7);color:var(--danger,#B42318);font:700 16px/1.55 'Gothic A1',system-ui,sans-serif;cursor:pointer;transition:transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn-danger:active{transform:scale(.97)}.ds-btn-danger:focus-visible{outline:2px solid var(--act,#1F7A5A);outline-offset:3px}"
