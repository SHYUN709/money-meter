      "html": "<label class=\"ds-field\"><span class=\"ds-field-lab\">시급 (원)</span><input class=\"ds-inp\" inputmode=\"numeric\" value=\"10320\"><span class=\"ds-help\">2026년 최저시급은 10,320원이에요.</span></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:'Gothic A1',system-ui,sans-serif;color:var(--ink,#222019)}.ds-field-lab{font-weight:700;font-size:.9375rem}.ds-inp{min-height:48px;padding:0 14px;border-radius:12px;border:1.5px solid var(--line,#E3DCD2);background:var(--card,#fff);color:inherit;font:500 16px 'Gothic A1',system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-inp:focus{border-color:var(--act,#1F7A5A);outline:2px solid var(--act,#1F7A5A);outline-offset:1px}.ds-help{color:var(--muted,#625B53);font-size:.8125rem}"
