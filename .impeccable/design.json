      "html": "<nav class=\"ds-tabbar\"><button aria-current=\"page\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 11l8-7 8 7v8.5a.5.5 0 0 1-.5.5H15v-6H9v6H4.5a.5.5 0 0 1-.5-.5z\"/></svg>홈</button><button><svg viewBox=\"0 0 24 24\"><path d=\"M7 3h10a1 1 0 0 1 1 1v17l-3-2-3 2-3-2-3 2V4a1 1 0 0 1 1-1zM9 8h6M9 12h6M9 16h3\"/></svg>기록</button><button><svg viewBox=\"0 0 24 24\"><path d=\"M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20c.6-3.3 3.3-5.5 6.5-5.5s5.9 2.2 6.5 5.5M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.9.7 3.2 2.5 3.5 5.2\"/></svg>친구</button><button><svg viewBox=\"0 0 24 24\"><path d=\"M4 7h9M17 7h3M15 5v4M4 17h3M11 17h9M9 15v4\"/></svg>설정</button></nav>",
      "css": ".ds-tabbar{display:grid;grid-template-columns:repeat(4,1fr);width:min(560px,100%);padding:6px;border-radius:22px;background:var(--card,#fff);box-shadow:var(--shadow-float,0 2px 6px rgba(60,45,30,.08),0 12px 32px rgba(60,45,30,.12))}.ds-tabbar button{display:grid;justify-items:center;gap:2px;min-height:56px;padding:8px 4px;border:0;border-radius:16px;background:none;color:var(--muted,#625B53);font:600 .8125rem 'Gothic A1',system-ui,sans-serif;cursor:pointer}.ds-tabbar svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-tabbar button:hover{color:var(--ink,#222019)}.ds-tabbar button[aria-current=page]{color:var(--act,#1F7A5A);background:var(--act-soft,#E3F1EA)}.ds-tabbar button:focus-visible{outline:2px solid var(--act,#1F7A5A);outline-offset:3px}"
